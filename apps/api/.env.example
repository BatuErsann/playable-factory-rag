PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playable_rag
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
CORPUS_PATH=../../corpus

# Automatically scan the corpus for new, changed, or removed Markdown files.
AUTO_INGEST_ENABLED=true
AUTO_INGEST_INTERVAL_MS=60000

# Production always uses Secure=true; local development defaults to false.
COOKIE_SECURE=false
# Use "none" with COOKIE_SECURE=true only for truly cross-site HTTPS deployments.
COOKIE_SAME_SITE=lax
# Usually unnecessary for a host-only API cookie. Example: .example.com
# COOKIE_DOMAIN=

# Required only when exposing the remote HTTP MCP endpoint at /mcp.
# Generate a long random value and keep it out of source control.
MCP_API_KEY=replace-with-a-long-random-mcp-api-key
# Optional comma-separated browser origins permitted to call /mcp.
# MCP_ALLOWED_ORIGINS=https://mcp-client.example.com
