PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playable_rag
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key

# Production always uses Secure=true; local development defaults to false.
COOKIE_SECURE=false
# Use "none" with COOKIE_SECURE=true only for truly cross-site HTTPS deployments.
COOKIE_SAME_SITE=lax
# Usually unnecessary for a host-only API cookie. Example: .example.com
# COOKIE_DOMAIN=
