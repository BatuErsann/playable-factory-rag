# Doxygen configuration for the Playable Factory AI monorepo.

PROJECT_NAME           = "Playable Factory AI"
PROJECT_BRIEF          = "Retrieval-augmented knowledge assistant"
PROJECT_NUMBER         = "1.0.0"

OUTPUT_DIRECTORY       = docs/generated
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

INPUT                  = readme.md \
                         apps/api/src \
                         apps/web/lib \
                         apps/web/components
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.md \
                         *.ts \
                         *.tsx
RECURSIVE              = YES
EXCLUDE                = apps/api/dist \
                         apps/web/.next \
                         docs/generated \
                         node_modules
EXCLUDE_PATTERNS       = */node_modules/* \
                         */.next/* \
                         */dist/* \
                         */seed.ts \
                         */test-*.ts

EXTENSION_MAPPING      = ts=JavaScript \
                         tsx=JavaScript
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = readme.md
AUTOLINK_SUPPORT       = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_JAVA   = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
